# 复制为 .env.local 后填写。该文件不会被提交（见 .gitignore）。
# 所有凭证只允许存在于服务端环境变量，禁止进入前端、日志、截图或仓库。

# 【必填】知乎开放平台 Access Secret
# 获取位置：https://developer.zhihu.com/profile → 密钥管理
ZHIHU_ACCESS_SECRET=

# 【OAuth 登录】需向 openplatform@zhihu.com 申请后填写，缺任一项则登录入口自动隐藏
# 申请邮件需含：应用名称/简介/图标(>=256x256)/回调地址/申请人姓名+手机号+知乎主页/权限范围
ZHIHU_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 申请时登记的主回调地址（线上）
ZHIHU_REDIRECT_URI=https://zhihu.cauai.fun/api/auth/callback
# 第二个已登记的回调地址（本地调试用）。不填则本地也用上面那个。
ZHIHU_REDIRECT_URI_ALT=http://localhost:3000/api/auth/callback
# 会话签名密钥。不填则退回用 ZHIHU_ACCESS_SECRET 签名。
SESSION_SECRET=

# 【预留】数据层。P0 使用浏览器 localStorage，无需数据库。
# P1 换成 Postgres/SQLite 时填写。
DATABASE_URL=
