# 复制为 .env.local 后填写。该文件不会被提交（见 .gitignore）。
# 所有凭证只允许存在于服务端环境变量，禁止进入前端、日志、截图或仓库。

# 【必填】知乎开放平台 Access Secret
# 获取位置：https://developer.zhihu.com/profile → 密钥管理
ZHIHU_ACCESS_SECRET=

# 【预留】OAuth 应用凭证：需向 openplatform@zhihu.com 或赛事页面申请后填写
# 当前版本未使用；接入 OAuth 登录时再填。
ZHIHU_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 【预留】数据层。P0 使用浏览器 localStorage，无需数据库。
# P1 换成 Postgres/SQLite 时填写。
DATABASE_URL=
